          "name": "Submit a transaction",
          "request": {
            "name": "Submit a transaction",
            "description": {
              "content": "Push a new transaction to the node. The signed transaction is validated and, depending on mode, returned when accepted (async), when validated (sync), or when committed to a block (commit).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "transactions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "mode",
                  "value": "async",
                  "description": "Persistence/acknowledgement mode for the submitted transaction."
                }
              ],
              "variable": [
                {
                  "description": "Hostname of a BigchainDB node (the IPDB test network historically ran at test.ipdb.io).",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"

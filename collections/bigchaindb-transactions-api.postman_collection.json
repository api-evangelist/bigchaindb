          "name": "List transactions for an asset",
          "request": {
            "name": "List transactions for an asset",
            "description": {
              "content": "Get a list of transactions that use an asset with the given asset_id. The operation type (CREATE or TRANSFER) may be filtered, and last_tx returns only the latest transaction.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "transactions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "asset_id",
                  "value": "<string>",
                  "description": "(Required) The asset id to filter transactions by."
                },
                {
                  "disabled": false,
                  "key": "operation",
                  "value": "<string>",
                  "description": "Filter by transaction operation."
                },
                {
                  "disabled": false,
                  "key": "last_tx",
                  "value": "<boolean>",
                  "description": "When true, return only the last transaction."

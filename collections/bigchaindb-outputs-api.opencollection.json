{
  "opencollection": "1.0.0",
  "info": {
    "name": "BigchainDB HTTP Assets Outputs API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Outputs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List outputs by public key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}:9984/api/v1/outputs",
            "params": [
              {
                "name": "public_key",
                "value": "",
                "type": "query",
                "description": "The public key to list outputs for."
              },
              {
                "name": "spent",
                "value": "",
                "type": "query",
                "description": "When set, filter to spent (true) or unspent (false) outputs."
              }
            ]
          },
          "docs": "Get transaction outputs associated with a given public key. Optionally filter to only spent or only unspent outputs."
        }
      ]
    }
  ],
  "bundled": true
}